rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ansehen: jeder mit dem Link. Ändern: nur das eingetragene Google-Konto.
    function istAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ADMIN_EMAIL_HIER'];
    }
    match /einheiten/{id} {
      allow read: if true;
      allow update: if istAdmin();
      allow create, delete: if false;
    }
    match /uebungen/{id} {
      allow read: if true;
      allow update: if istAdmin();
      allow create, delete: if false;
    }
  }
}
